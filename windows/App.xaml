<Application
    x:Class="RivetHost.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- App-level so {ThemeResource} references in MainWindow.xaml
                     resolve while the window XAML is still parsing (a
                     same-element Grid.Resources definition is evaluated
                     before the resources exist and crashes the host). -->
                <!-- Tokens are the 2026-11 redesign's paired values
                     (design/prototype/shared.css): warm paper, terracotta
                     accent pair, one green pair reserved for goal met. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PaybackPaperBrush" Color="#FAF7F2" />
                    <SolidColorBrush x:Key="PaybackCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PaybackSidebarBrush" Color="#F2EDE6" />
                    <SolidColorBrush x:Key="PaybackInkBrush" Color="#302D29" />
                    <SolidColorBrush x:Key="PaybackMutedBrush" Color="#68635C" />
                    <SolidColorBrush x:Key="PaybackLineBrush" Color="#E1DCD4" />
                    <SolidColorBrush x:Key="PaybackSoftBrush" Color="#F3E5DC" />
                    <SolidColorBrush x:Key="PaybackCardHoverBrush" Color="#F3E5DC" />
                    <!-- goal-met green, used for nothing else -->
                    <SolidColorBrush x:Key="PaybackEarnBrush" Color="#276D3B" />
                    <SolidColorBrush x:Key="PaybackEarnSoftBrush" Color="#E7F0E7" />
                    <!-- terracotta accent: value, progress, primary actions
                         (light #A64A2B; closes #58's dark divergence) -->
                    <SolidColorBrush x:Key="PaybackAccentBrush" Color="#A64A2B" />
                    <SolidColorBrush x:Key="PaybackAccentHoverBrush" Color="#913E23" />
                    <SolidColorBrush x:Key="PaybackAccentSoftBrush" Color="#F3E5DC" />
                    <!-- destructive red only -->
                    <SolidColorBrush x:Key="PaybackDangerBrush" Color="#B32C28" />
                    <SolidColorBrush x:Key="PaybackDangerSoftBrush" Color="#FBE9E7" />
                    <!-- legacy category badge tints (kept for the row tiles
                         until the S4 icon pass; hues unchanged) -->
                    <SolidColorBrush x:Key="PaybackCatComputerBrush" Color="#23007AFF" />
                    <SolidColorBrush x:Key="PaybackCatPhoneBrush" Color="#2330B0C7" />
                    <SolidColorBrush x:Key="PaybackCatTabletBrush" Color="#235856D6" />
                    <SolidColorBrush x:Key="PaybackCatWatchBrush" Color="#2E00C7BE" />
                    <SolidColorBrush x:Key="PaybackCatAudioBrush" Color="#23AF52DE" />
                    <SolidColorBrush x:Key="PaybackCatCameraBrush" Color="#29FF9500" />
                    <SolidColorBrush x:Key="PaybackCatGamingBrush" Color="#21FF3B30" />
                    <SolidColorBrush x:Key="PaybackCatApplianceBrush" Color="#2632ADE6" />
                    <SolidColorBrush x:Key="PaybackCatAccessoryBrush" Color="#2900C7BE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PaybackPaperBrush" Color="#211F1C" />
                    <SolidColorBrush x:Key="PaybackCardBrush" Color="#2B2926" />
                    <SolidColorBrush x:Key="PaybackSidebarBrush" Color="#25221F" />
                    <SolidColorBrush x:Key="PaybackInkBrush" Color="#EEE9E2" />
                    <SolidColorBrush x:Key="PaybackMutedBrush" Color="#B9B1A7" />
                    <SolidColorBrush x:Key="PaybackLineBrush" Color="#47413B" />
                    <SolidColorBrush x:Key="PaybackSoftBrush" Color="#423127" />
                    <SolidColorBrush x:Key="PaybackCardHoverBrush" Color="#423127" />
                    <SolidColorBrush x:Key="PaybackEarnBrush" Color="#8BC79B" />
                    <SolidColorBrush x:Key="PaybackEarnSoftBrush" Color="#293B2D" />
                    <SolidColorBrush x:Key="PaybackAccentBrush" Color="#E5A17E" />
                    <SolidColorBrush x:Key="PaybackAccentHoverBrush" Color="#EFB596" />
                    <SolidColorBrush x:Key="PaybackAccentSoftBrush" Color="#423127" />
                    <SolidColorBrush x:Key="PaybackDangerBrush" Color="#FF9B92" />
                    <SolidColorBrush x:Key="PaybackDangerSoftBrush" Color="#452D29" />
                    <SolidColorBrush x:Key="PaybackCatComputerBrush" Color="#23007AFF" />
                    <SolidColorBrush x:Key="PaybackCatPhoneBrush" Color="#2330B0C7" />
                    <SolidColorBrush x:Key="PaybackCatTabletBrush" Color="#235856D6" />
                    <SolidColorBrush x:Key="PaybackCatWatchBrush" Color="#2E00C7BE" />
                    <SolidColorBrush x:Key="PaybackCatAudioBrush" Color="#23AF52DE" />
                    <SolidColorBrush x:Key="PaybackCatCameraBrush" Color="#29FF9500" />
                    <SolidColorBrush x:Key="PaybackCatGamingBrush" Color="#21FF3B30" />
                    <SolidColorBrush x:Key="PaybackCatApplianceBrush" Color="#2632ADE6" />
                    <SolidColorBrush x:Key="PaybackCatAccessoryBrush" Color="#2900C7BE" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
