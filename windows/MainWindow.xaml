<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PaybackPaperBrush and friends live in App.xaml's theme dictionaries;
         defining them here on the same element crashes the XAML parser. -->
    <Grid RowSpacing="0" Background="{ThemeResource PaybackPaperBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            x:Name="StatusBar"
            Margin="20,10,20,0"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational">
            <!-- InfoBar has no IsTextSelectionEnabled of its own; the status
                 copy must leave the screen with the user, so it lives in a
                 selectable TextBlock hosted as the InfoBar content. -->
            <InfoBar.Content>
                <TextBlock
                    x:Name="StatusMessage"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </InfoBar.Content>
            <!-- the delete toast's 撤销: reinstates the tombstoned record -->
            <InfoBar.ActionButton>
                <Button
                    x:Name="UndoButton"
                    Visibility="Collapsed"
                    Click="UndoButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- toolbar: the detail pane shows only the device; its actions live
             here as quiet borderless icons, the way Mail/Notes do it -->
        <CommandBar
            Grid.Row="1"
            x:Name="Toolbar"
            Margin="10,4,10,4"
            Background="Transparent"
            IsOpen="False"
            DefaultLabelPosition="Collapsed"
            OverflowButtonVisibility="Collapsed">
            <CommandBar.PrimaryCommands>
                <AppBarElementContainer>
                    <ComboBox x:Name="SortBox" SelectionChanged="SortBox_SelectionChanged" Width="150">
                        <ComboBoxItem Content="加入顺序" IsSelected="True" />
                        <ComboBoxItem Content="最近购买" />
                        <ComboBoxItem Content="每日成本" />
                    </ComboBox>
                </AppBarElementContainer>
                <AppBarButton x:Name="EditButton" IsEnabled="False" Click="EditButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" IsEnabled="False" Click="DeleteButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="AddButton" IsEnabled="False" Click="AddButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarElementContainer>
                    <ComboBox x:Name="LanguageBox" Width="120" SelectionChanged="LanguageBox_SelectionChanged">
                        <ComboBoxItem Content="跟随系统" IsSelected="True" />
                        <ComboBoxItem Content="中文" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </AppBarElementContainer>
                <AppBarButton x:Name="SettingsButton" Click="SettingsButton_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <!-- Help menu convention: Check for Updates… and About live
                     together in one menu, not as toolbar buttons. -->
                <AppBarButton x:Name="HelpButton">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MenuCheckUpdates" Click="CheckUpdates_Click">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="U" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuAbout" Click="AboutButton_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>

        <!-- nonmodal split (mac NavigationSplitView parity): the pane holds
             the summary plus the device list, selection drives the detail
             pane in place, no dialog between the user and the next device -->
        <NavigationView
            Grid.Row="2"
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="330"
            SelectionChanged="NavView_SelectionChanged"
            Visibility="Collapsed">
            <NavigationView.Resources>
                <!-- the pane and content sit on the same paper as the window
                     root; the template's default layered fills read as seams
                     over it (transparent resolves to paper in both themes) -->
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <NavigationView.PaneCustomContent>
                <StackPanel>
                    <!-- 2026-11 redesign summary: investment hero for the
                         default currency group, static caption, two mini
                         stats (design/DESIGN.md; the earned tile is retired
                         with the terminology contract) -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,12,16,10">
                        <Border
                            Width="32" Height="32" CornerRadius="10"
                            Background="{ThemeResource PaybackAccentBrush}">
                            <TextBlock
                                Text="&#xE72A;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="{ThemeResource PaybackPaperBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            x:Name="BrandText" Text="Payback"
                            FontSize="21" FontWeight="SemiBold"
                            Foreground="{ThemeResource PaybackInkBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="InvestmentEyebrow"
                        Margin="20,0,16,0"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="{ThemeResource PaybackMutedBrush}" />
                    <TextBlock
                        x:Name="TotalSpentText" Text="—"
                        Margin="20,6,16,0"
                        FontSize="28" FontWeight="SemiBold"
                        Foreground="{ThemeResource PaybackInkBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SummaryCaption"
                        Margin="20,6,16,0"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource PaybackMutedBrush}" />
                    <Grid ColumnSpacing="16" Margin="20,18,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <!-- 合计每日成本: Σ per-device daily costs, not the
                                 portfolio average (2026-11 redesign) -->
                            <TextBlock x:Name="DailyTotalText" Text="—" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PaybackInkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DailyTotalLabel" FontSize="12"
                                       Foreground="{ThemeResource PaybackMutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="DeviceCountText" Text="0" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PaybackInkBrush}" />
                            <TextBlock x:Name="DeviceCountLabel" FontSize="12"
                                       Foreground="{ThemeResource PaybackMutedBrush}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="MixedCurrencyNote"
                        Margin="20,10,16,0"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource PaybackMutedBrush}"
                        Visibility="Collapsed" />
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <!-- detail pane: device identity, payback math, curve, ladder;
                 built in code (RenderDetail) -->
            <ScrollViewer>
                <StackPanel x:Name="DetailPanel" Spacing="16" Padding="24,16,24,24" />
            </ScrollViewer>
        </NavigationView>

        <!-- empty state replaces the whole split, the way the mac host does -->
        <StackPanel
            Grid.Row="2"
            x:Name="EmptyState"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Border
                Width="80"
                Height="80"
                CornerRadius="24"
                HorizontalAlignment="Center"
                Background="{ThemeResource PaybackSoftBrush}">
                <TextBlock
                    Text="&#xE719;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="34"
                    Foreground="{ThemeResource PaybackAccentBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="EmptyTitleText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource PaybackInkBrush}" />
            <TextBlock
                x:Name="EmptyHintText"
                Foreground="{ThemeResource PaybackMutedBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="380"
                HorizontalAlignment="Center" />
            <Button x:Name="EmptyAddButton" IsEnabled="False" Click="AddButton_Click" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
